[Unit]
Description=Gunicorn instance to serve citsignups
After=network.target

[Service]
User=grit
Group=www-data
WorkingDirectory=/home/grit/www
Environment=PATH=/home/grit/www/venv/bin
ExecStart=/home/grit/www/venv/bin/gunicorn --workers 3 --bind unix:/home/grit/www/citsignups.sock -m 007 wsgi:app
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
